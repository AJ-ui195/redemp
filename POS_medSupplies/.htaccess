<IfModule mod_authz_core.c>
    <Files ".env">
        Require all denied
    </Files>
    <Files ".env.example">
        Require all denied
    </Files>
    <Files "composer.json">
        Require all denied
    </Files>
    <Files "composer.lock">
        Require all denied
    </Files>
    <Files "artisan">
        Require all denied
    </Files>
    <Files "phpunit.xml">
        Require all denied
    </Files>
</IfModule>

<IfModule !mod_authz_core.c>
    <Files ".env">
        Order allow,deny
        Deny from all
    </Files>
    <Files ".env.example">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # SSL / domain validation (Hostinger, Let's Encrypt)
    RewriteRule ^\.well-known/ - [L]

    # Block direct web access to Laravel internals
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor|node_modules)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\.|$)|composer\.(?:json|lock)|artisan|phpunit\.xml)$ - [F,L,NC]

    # Serve the application from public/ (public/index.php uses ../vendor, ../bootstrap, etc.)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
